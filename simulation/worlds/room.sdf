<?xml version="1.0" encoding="UTF-8"?>
<!-- 
   Gazebo Harmonic Indoor Multi-Room Environment (No Ceiling)
   This SDF file creates a simple, ceiling-less indoor space with multiple rooms
   using basic box geometries. Rooms are separated by partition walls with doorways.
-->
<sdf version="1.9">
  <world name="room">
    
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>
    <plugin name="gz::sim::systems::AirPressure" filename="gz-sim-air-pressure-system"/>
    <plugin name="gz::sim::systems::ApplyLinkWrench" filename="gz-sim-apply-link-wrench-system"/>
    <plugin name="gz::sim::systems::NavSat" filename="gz-sim-navsat-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <gui fullscreen="false">
      <!-- 3D scene -->
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>gui_scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <camera_pose>-6 0 6 0 0.5 0</camera_pose>
        <camera_clip>
          <near>0.25</near>
          <far>25000</far>
        </camera_clip>
      </plugin>
      <!-- Plugins that add functionality to the scene -->
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="MarkerManager" name="Marker manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="SelectEntities" name="Select Entities">
        <gz-gui>
          <anchors target="Select entities">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="VisualizationCapabilities" name="Visualization Capabilities">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="Spawn" name="Spawn Entities">
        <gz-gui>
          <anchors target="Select entities">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin name="World control" filename="WorldControl">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">0</property>
          <property type="bool" key="resizable">0</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>1</play_pause>
        <step>1</step>
        <start_paused>1</start_paused>
      </plugin>
      <plugin name="World stats" filename="WorldStats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">0</property>
          <property type="bool" key="resizable">0</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>1</sim_time>
        <real_time>1</real_time>
        <real_time_factor>1</real_time_factor>
        <iterations>1</iterations>
      </plugin>
      <plugin name="Entity tree" filename="EntityTree"/>
    </gui>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- 地面：一个大的平面盒子，作为所有房间的基底 -->
    <model name="ground_floor">
      <static>true</static>
      <link name="floor_link">
        <visual name="floor_visual">
          <geometry>
            <box>
              <size>20 20 0.2</size> <!-- 面积20x20米，厚度0.2米 -->
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="floor_collision">
          <geometry>
            <box>
              <size>20 20 0.2</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- ================= 外墙 ================= -->
    <!-- 北墙 (位于世界坐标 Y = 9.5 处，沿X轴方向) -->
    <model name="outer_wall_north">
      <static>true</static>
      <pose>0 9.5 2.5 0 0 0</pose>
      <link name="wall_link">
        <visual name="wall_visual">
          <geometry>
            <box>
              <size>20 0.2 5.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.6 0.5 1</ambient>
            <diffuse>0.8 0.7 0.6 1</diffuse>
          </material>
        </visual>
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>20 0.2 5.0</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- 南墙 (Y = -9.5) -->
    <model name="outer_wall_south">
      <static>true</static>
      <pose>0 -9.5 2.5 0 0 0</pose>
      <link name="wall_link">
        <visual name="wall_visual">
          <geometry>
            <box>
              <size>20 0.2 5.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.6 0.5 1</ambient>
            <diffuse>0.8 0.7 0.6 1</diffuse>
          </material>
        </visual>
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>20 0.2 5.0</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- 东墙 (X = 9.5) -->
    <model name="outer_wall_east">
      <static>true</static>
      <pose>9.5 0 2.5 0 0 0</pose>
      <link name="wall_link">
        <visual name="wall_visual">
          <geometry>
            <box>
              <size>0.2 20 5.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.6 0.5 1</ambient>
            <diffuse>0.8 0.7 0.6 1</diffuse>
          </material>
        </visual>
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>0.2 20 5.0</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- 西墙 (X = -9.5) -->
    <model name="outer_wall_west">
      <static>true</static>
      <pose>-9.5 0 2.5 0 0 0</pose>
      <link name="wall_link">
        <visual name="wall_visual">
          <geometry>
            <box>
              <size>0.2 20 5.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.6 0.5 1</ambient>
            <diffuse>0.8 0.7 0.6 1</diffuse>
          </material>
        </visual>
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>0.2 20 5.0</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- ================= 内部隔墙 ================= -->
    <!-- 隔墙1：将空间分为左右两大区域（南北走向，位于X=0处，带门洞） 
         实际做成两段墙：一段在Y正半区，一段在Y负半区，中间留门 -->
    <!-- 北段内墙 (Y: 0.5 到 9.0) -->
    <model name="inner_wall_center_north">
      <static>true</static>
      <pose>0 5.8 2.5 0 0 0</pose>
      <link name="wall_link">
        <visual name="wall_visual">
          <geometry>
            <box>
              <size>0.2 6.0 5.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.5 0.4 1</ambient>
            <diffuse>0.7 0.6 0.5 1</diffuse>
          </material>
        </visual>
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>0.2 6.0 5.0</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- 南段内墙 (Y: -9.0 到 -0.5) -->
    <model name="inner_wall_center_south">
      <static>true</static>
      <pose>0 -5.8 2.5 0 0 0</pose>
      <link name="wall_link">
        <visual name="wall_visual">
          <geometry>
            <box>
              <size>0.2 6.0 5.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.5 0.4 1</ambient>
            <diffuse>0.7 0.6 0.5 1</diffuse>
          </material>
        </visual>
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>0.2 6.0 5.0</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- 隔墙2：横向分割上半区域，形成两个小房间 (位于Y=2.5, X从 -3 到 3) 带门洞方式：左右两段 -->
    <model name="inner_wall_horizontal_left">
      <static>true</static>
      <pose>-1.5 3.0 2.5 0 0 0</pose>
      <link name="wall_link">
        <visual name="wall_visual">
          <geometry>
            <box>
              <size>3.0 0.2 5.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.5 0.4 1</ambient>
            <diffuse>0.7 0.6 0.5 1</diffuse>
          </material>
        </visual>
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>3.0 0.2 5.0</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="inner_wall_horizontal_right">
      <static>true</static>
      <pose>1.5 3.0 2.5 0 0 0</pose>
      <link name="wall_link">
        <visual name="wall_visual">
          <geometry>
            <box>
              <size>3.0 0.2 5.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.5 0.4 1</ambient>
            <diffuse>0.7 0.6 0.5 1</diffuse>
          </material>
        </visual>
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>3.0 0.2 5.0</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- 隔墙3：另一条横向分割，位于下半区域 Y = -3.0 处 -->
    <model name="inner_wall_lower">
      <static>true</static>
      <pose>0 -3.0 2.5 0 0 0</pose>
      <link name="wall_link">
        <visual name="wall_visual">
          <geometry>
            <box>
              <size>7.0 0.2 5.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.5 0.4 1</ambient>
            <diffuse>0.7 0.6 0.5 1</diffuse>
          </material>
        </visual>
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>7.0 0.2 5.0</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- 可选：增加一个小方块作为房间内的桌子或障碍物示例，并非墙，但增加真实感 -->
    <model name="table_example">
      <static>true</static>
      <pose>2.5 -1.5 0.5 0 0 0</pose>
      <link name="table_link">
        <visual name="table_visual">
          <geometry>
            <box>
              <size>1.0 1.0 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.2 0.1 1</ambient>
            <diffuse>0.5 0.4 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="table_collision">
          <geometry>
            <box>
              <size>1.0 1.0 1.0</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- 另一个装饰性障碍物，圆柱体，模拟柱子 -->
    <model name="pillar">
      <static>true</static>
      <pose>-2.5 5.0 0.75 0 0 0</pose>
      <link name="pillar_link">
        <visual name="pillar_visual">
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>1.5</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.9 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <collision name="pillar_collision">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>1.5</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- ================= 家具/点缀 (简单形状) ================= -->
    <!-- 在左下角房间放一个柜子形状 -->
    <model name="cabinet">
      <static>true</static>
      <pose>-5.5 -6.0 1.1 0 0 0</pose>
      <link name="cabinet_link">
        <visual name="cabinet_visual">
          <geometry>
            <box>
              <size>1.2 0.8 2.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.3 0.4 1</ambient>
            <diffuse>0.3 0.4 0.5 1</diffuse>
          </material>
        </visual>
        <collision name="cabinet_collision">
          <geometry>
            <box>
              <size>1.2 0.8 2.2</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- ================= 可选：标记房间区域 (可视化辅助) ================= -->
    <!-- 在地面上添加不同颜色的半透明区域来标示房间，不影响物理 -->
    <model name="room_marker_1">
      <static>true</static>
      <pose>-4.5 6.5 0.05 0 0 0</pose>
      <link name="marker_link">
        <visual name="marker_visual">
          <geometry>
            <box>
              <size>5.0 5.0 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.6 0.8 0.4</ambient>  
            <diffuse>0.3 0.6 0.8 0.4</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="room_marker_2">
      <static>true</static>
      <pose>4.5 6.5 0.05 0 0 0</pose>
      <link name="marker_link">
        <visual name="marker_visual">
          <geometry>
            <box>
              <size>5.0 5.0 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.6 0.8 0.4</ambient>  
            <diffuse>0.3 0.6 0.8 0.4</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg> 8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

  </world>
</sdf>